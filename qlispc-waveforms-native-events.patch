 class Signal(Flag):
@@ -42,6 +42,80 @@ class QLispError(SyntaxError):
     pass


+@dataclass(frozen=True, slots=True)
+class WaveformEvent:
+    """One compiler event referencing an immutable waveform template."""
+
+    template: Waveform
+    delay_tick: int = 0
+    scale: float = 1.0
+
+    def materialize(self):
+        return self.scale * self.template >> tick_to_time(self.delay_tick)
+
+
+class WaveformEventList:
+    """Channel-local event stream with a columnar native-stack finalizer."""
+
+    __slots__ = ('_items', )
+
+    def __init__(self):
+        self._items = []
+
+    def append(self, item):
+        if not isinstance(item, (Waveform, WaveformEvent)):
+            raise TypeError('expected Waveform or WaveformEvent')
+        self._items.append(item)
+
+    def __len__(self):
+        return len(self._items)
+
+    def __iter__(self):
+        return iter(self._items)
+
+    @staticmethod
+    def _build_events(events):
+        templates = []
+        template_map = {}
+        template_ids = []
+        delay_ticks = []
+        scales = []
+        for event in events:
+            if event.scale == 0 or event.template.is_zero():
+                continue
+            key = event.template.to_bytes()
+            template_id = template_map.get(key)
+            if template_id is None:
+                template_id = len(templates)
+                template_map[key] = template_id
+                templates.append(event.template)
+            template_ids.append(template_id)
+            delay_ticks.append(event.delay_tick)
+            scales.append(event.scale)
+        return WaveVStack.from_events(
+            templates, template_ids, delay_ticks, scales)
+
+    def build(self):
+        # Preserve accumulation order when optimized events and general
+        # waveform expressions appear on the same physical channel.
+        result = WaveVStack()
+        cursor = 0
+        while cursor < len(self._items):
+            event_batch = isinstance(self._items[cursor], WaveformEvent)
+            stop = cursor + 1
+            while (stop < len(self._items)
+                   and isinstance(self._items[stop], WaveformEvent)
+                   == event_batch):
+                stop += 1
+            batch = self._items[cursor:stop]
+            if event_batch:
+                result += self._build_events(batch)
+            else:
+                result += WaveVStack(batch)
+            cursor = stop
+        return result
+
