def basic_expression(opcode: int, args: tuple = ..., shift: float = ...) -> tuple: ...
def affine_expression(opcode: int, args: tuple = ..., shift: float = ...,
                      scale: float = ..., offset: float = ...) -> tuple: ...
def piecewise(bounds: tuple, expressions: tuple) -> PackedWaveform: ...
def piecewise_canonical(bounds: tuple, expressions: tuple) -> PackedWaveform: ...
def sum_cores(cores: Iterable[PackedWaveform]) -> PackedWaveform: ...
def set_time_resolution(value: float) -> None: ...
def get_time_resolution() -> float: ...
def quantize_time(value: float) -> float: ...
def time_to_tick(value: float) -> int: ...
def tick_to_time(tick: int) -> float: ...
def sample_clock(sample_rate: int | float) -> tuple[int, int]: ...
def sample_grid(start_tick: int, count: int, step_numerator: int,
